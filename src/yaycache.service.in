[Unit]
Description=Remove unused cached package files

[Service]
Type=oneshot
# Extra arguments come from YAYCACHE_ARGS in @sysconfdir@/yaycache.conf, or from
# $XDG_CONFIG_HOME/yaycache.conf which takes precedence. See yaycache(8).
EnvironmentFile=-@sysconfdir@/yaycache.conf
EnvironmentFile=-%E/yaycache.conf
ExecStart=@bindir@/yaycache -r $YAYCACHE_ARGS
# Lowering priority
OOMScoreAdjust=1000
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
IOSchedulingPriority=7
# Sandboxing and other hardening
NoNewPrivileges=yes
ProtectSystem=full
RestrictAddressFamilies=none
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service @file-system
SystemCallArchitectures=native
